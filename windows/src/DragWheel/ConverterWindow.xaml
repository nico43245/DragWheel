<Window x:Class="DragWheel.ConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragWheel" Width="860" Height="560" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" AllowDrop="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="18">
            <!-- Drop zone -->
            <Border x:Name="DropZone" DockPanel.Dock="Top" Height="170" CornerRadius="14"
                    BorderThickness="2" BorderBrush="#88888888" Background="#08000000" Padding="12">
                <Grid>
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="Drop files here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,8" Opacity="0.7" />
                        <Button Content="Choose Files…" Click="ChooseFiles" Padding="12,4" HorizontalAlignment="Center" />
                    </StackPanel>
                    <DockPanel x:Name="FileListPanel" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear" Click="ClearFiles" Padding="10,2" Margin="6,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Add…" Click="ChooseFiles" Padding="10,2" />
                            <TextBlock x:Name="FileCount" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Pages -->
            <StackPanel x:Name="PageTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,10" />

            <!-- Actions -->
            <Grid>
                <ItemsControl x:Name="ActionGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="6" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <!-- Recent -->
        <Border Grid.Column="1" BorderBrush="#22000000" BorderThickness="1,0,0,0" Background="#06000000">
            <DockPanel Margin="14">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Clear" Click="ClearHistory" Padding="10,2" />
                    <TextBlock Text="Recent" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="RevealRecent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DragWheel</RootNamespace>
    <AssemblyName>DragWheel</AssemblyName>
    <ApplicationIcon>Assets\DragWheel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF owns DPI awareness through app.manifest; the WinForms tray icon just follows it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DragWheel.Core\DragWheel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DragWheel.ico" />
    <!-- WinForms and WPF both define these; we use the WPF ones by default. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

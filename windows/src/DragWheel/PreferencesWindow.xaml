<Window x:Class="DragWheel.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragWheel Preferences" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Output" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
        <RadioButton x:Name="NextToSource" Content="Save next to the original file" GroupName="out" Margin="0,2" />
        <RadioButton x:Name="CustomFolder" Content="Save to a folder I choose" GroupName="out" Margin="0,2" />
        <DockPanel x:Name="FolderRow" Margin="22,4,0,0">
            <Button DockPanel.Dock="Right" Content="Choose…" Click="ChooseFolder" Padding="10,2" Margin="8,0,0,0" />
            <TextBlock x:Name="FolderPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.7" />
        </DockPanel>

        <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Right" x:Name="QualityValue" Width="40" TextAlignment="Right" />
            <TextBlock Text="Quality" Width="70" />
            <Slider x:Name="Quality" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
        </DockPanel>
        <TextBlock Text="Lower means smaller files (JPEG, HEIC, AVIF, WebP, video)." FontSize="11" Opacity="0.6" Margin="70,2,0,0" />

        <TextBlock Text="Behaviour" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6" />
        <CheckBox x:Name="PlaySound" Content="Play a sound when done" Margin="0,2" />
        <CheckBox x:Name="Reveal" Content="Show results in File Explorer" Margin="0,2" />
        <CheckBox x:Name="AnyApp" Content="Show the wheel for drags from any app (not only File Explorer)" Margin="0,2" />
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Margin="0,2" />

        <TextBlock Text="Look" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6" />
        <ComboBox x:Name="ThemePicker" DisplayMemberPath="Label" SelectedValuePath="Id" Width="240" HorizontalAlignment="Left" />

        <TextBlock Text="Helpers" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6" />
        <DockPanel>
            <TextBlock Text="ffmpeg (video &amp; audio)" Width="170" />
            <TextBlock x:Name="FFmpegStatus" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Margin="0,4,0,0">
            <TextBlock Text="Text recognition (OCR)" Width="170" />
            <TextBlock x:Name="OcrStatus" TextWrapping="Wrap" />
        </DockPanel>

        <Button Content="Done" IsDefault="True" Click="Done" HorizontalAlignment="Right" Padding="18,4" Margin="0,20,0,0" />
    </StackPanel>
</Window>
